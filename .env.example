# claude-box — настройки. Обычно этот файл создаёт и дополняет ./install.sh (права 600).
# Значения с символом $ берите в одинарные кавычки: SOCKS_PASS='pa$$word'
# Пустое значение = умолчание профиля (profiles/<профиль>.env) или встроенное.

# ───────────── Профиль и возможности ─────────────
# mac | server (по умолчанию — по ОС: macOS -> mac, Linux -> server)
PROFILE=
# Chrome + noVNC + DevTools MCP (браузер агента): 1 | 0
BROWSER=
# Docker хоста для агента: ro — только чтение (ps, logs, inspect); 0 — нет. Изменения — всегда через ssh с подтверждением
HOST_DOCKER=
# SSH-доступ агента к хосту (каждая команда — с вашего подтверждения): 1 | 0
HOST_ACCESS=
# Алиас хоста для агента: mac (на Mac) / host (на сервере)
HOST_ALIAS=
HOST_SSH_USER=
HOST_SSH_PORT=22
# Другие серверы для агента (через прокси, с подтверждением): "vds=root@203.0.113.5:22 other=user@host"
SSH_HOSTS=

# ───────────── SOCKS5-прокси (обязательно) ─────────────
# Лучше указывать IP: имя хоста один раз резолвится через локальный DNS до включения защиты.
SOCKS_HOST=
SOCKS_PORT=
SOCKS_USER=
SOCKS_PASS=
# 1 — если прокси поддерживает UDP (UDP ASSOCIATE). Иначе весь UDP (кроме DNS) блокируется.
ALLOW_UDP=0
# DoH-резолвер (только IP!). Запросы к нему идут ВНУТРИ прокси.
DOH_SERVER=1.1.1.1

# ───────────── Гео (пусто = автоопределение по IP прокси) ─────────────
GEO_TZ=
GEO_LOCALE=
GEO_ACCEPT_LANG=

# ───────────── Имена и рабочая папка ─────────────
# Имя compose-проекта (тома <имя>_agent-home и т.д.) и префикс контейнеров (<префикс>-agent ...)
COMPOSE_PROJECT_NAME=
BOX_PREFIX=
# Имя машины и сервера Remote Control в приложении Claude
BOX_HOSTNAME=
RC_NAME=
# Рабочая папка на хосте -> /workspace в контейнерах
WORKSPACE_DIR=
PUID=
PGID=

# ───────────── Веб-интерфейсы ─────────────
# Адрес публикации портов: 127.0.0.1 — только с этой машины (на сервере — через SSH-туннель)
BIND_ADDR=
TTYD_PORT=7681
NOVNC_PORT=6080
TTYD_USER=agent
TTYD_PASSWORD=
# VNC использует только первые 8 символов
VNC_PASSWORD=
SCREEN=1600x900x24

# ───────────── Claude Code ─────────────
CLAUDE_RC=1
# Remote Control: single — один сервер на всю /workspace (имя RC_NAME) | projects — сервер на проект | off
RC_SERVER=single
RC_PROJECTS=auto
RC_PREFIX=
CLAUDE_ARGS=
DEVTOOLS_MCP=1
# 1 — дать агенту sudo внутри контейнера. Тогда он сможет переписать правила подтверждений. Не рекомендуется.
AGENT_SUDO=0

# ───────────── Сеть (обычно менять не нужно) ─────────────
# Подсеть claude-box; docker-ro получает статический адрес, динамические — из DOCKER_IP_RANGE
DOCKER_SUBNET=172.29.0.0/24
DOCKER_RO_IP=172.29.0.3
DOCKER_IP_RANGE=172.29.0.128/25
DOCKER_SOCK=/var/run/docker.sock
LAN_CIDRS=
# Подсети мимо прокси (напрямую). Обращения к ним агент делает только с вашим подтверждением.
DIRECT_CIDRS=
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:latest
SB_LOG_LEVEL=warn
# Быстрое обнаружение обрывов прокси (keepalive до прокси; повторы TCP: 7 ≈ 50 с, системное 15 ≈ 15 мин)
SB_KEEPALIVE=15s
SB_KEEPALIVE_INTERVAL=5s
TCP_RETRIES2=7

# ───────────── Служебное (пишет install.sh) ─────────────
COMPOSE_PROFILES=
