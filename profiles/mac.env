# Профиль mac: MacBook с OrbStack/Docker Desktop. Значения по умолчанию — любое можно переопределить в .env.
PROFILE=mac
COMPOSE_PROJECT_NAME=claude-box-mac
BOX_PREFIX=claude
BOX_HOSTNAME=claude-box-mac
RC_NAME=claude-box-mac
HOST_ALIAS=mac
HOST_ACCESS=1
BROWSER=1
HOST_DOCKER=0
BIND_ADDR=127.0.0.1
WORKSPACE_DIR=~/claude-workspace
