# Профиль server: Linux-сервер (VDS). Значения по умолчанию — любое можно переопределить в .env.
PROFILE=server
COMPOSE_PROJECT_NAME=claude-box
BOX_PREFIX=claude
BOX_HOSTNAME=claude-box-vds
RC_NAME=claude-box-vds
HOST_ALIAS=host
HOST_ACCESS=1
BROWSER=0
HOST_DOCKER=ro
BIND_ADDR=127.0.0.1
WORKSPACE_DIR=/srv/claude-workspace
